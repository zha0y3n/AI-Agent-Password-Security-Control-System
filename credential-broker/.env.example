# ---- Credential Broker ----
BROKER_ID=broker-01
BROKER_ADDR=:8080
BROKER_DB_PATH=data/broker.db
# 不存在时自动生成（0600），生产环境应预置
BROKER_SIGNING_KEY_FILE=data/broker-sm2.key
# 审计检查点专用私钥，必须与上面的 Receipt 签名私钥不同；不存在时自动生成（0600）
BROKER_CHECKPOINT_KEY_FILE=data/broker-checkpoint-sm2.key
# Vault 主密钥 K_V（SM4，16 字节 = 32 个十六进制字符）：openssl rand -hex 16
BROKER_VAULT_KEY=
# 管理接口令牌（录入 / 轮换 / 撤销 Credential），至少 16 字符：openssl rand -hex 24
BROKER_ADMIN_TOKEN=
BROKER_CHALLENGE_TTL=60s
BROKER_CHECKPOINT_EVERY=100
BROKER_UPSTREAM_URL=http://127.0.0.1:9090
BROKER_UPSTREAM_TIMEOUT=10s
# 可选：上游 TLS（需 https:// 上游）。CA 代替系统信任库；客户端证书用于上游要求 mTLS 时
BROKER_UPSTREAM_CA_FILE=
BROKER_UPSTREAM_CLIENT_CERT_FILE=
BROKER_UPSTREAM_CLIENT_KEY_FILE=
BROKER_LOG_LEVEL=info
# Receipt 签名公钥的标识与有效期（以 A 的 PublicKeyRecord 格式公布）
BROKER_KEY_ID=broker-key-01
BROKER_KEY_VALIDITY=8760h
# 执行接口：可信 AA issuer + AA / Agent 公钥表（A 运行时的 public-keys.json）。两项同时设置才开放 /v1/execute
BROKER_TRUSTED_ISSUER=aa-demo-01
BROKER_KEY_REGISTRY=../.runtime/public-keys.json
BROKER_CLOCK_SKEW=5s
# 可选：HTTPS（证书与私钥同时设置）；再设置客户端 CA 则强制 mTLS
BROKER_TLS_CERT_FILE=
BROKER_TLS_KEY_FILE=
BROKER_TLS_CLIENT_CA_FILE=
# 仅开发 / 实验环境：开放 POST /v1/admin/reset（清空全部 Broker 状态）
BROKER_ENABLE_RESET=0

# ---- Mock Upstream ----
MOCK_ADDR=:9090
# 需与通过管理接口录入 Broker 的 Credential 明文一致
MOCK_GIT_TOKEN=
MOCK_DB_TOKEN=
# 可选：Mock 以 HTTPS 监听；设置客户端 CA 后 Git / DB 接口只接受 Broker 的客户端证书
MOCK_TLS_CERT_FILE=
MOCK_TLS_KEY_FILE=
MOCK_TLS_CLIENT_CA_FILE=
