{
  "$id": "https://agent-credential-guard.example/schema/credential-status.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Public, non-secret Credential metadata returned by the trusted Broker.\n\nThis is deliberately separate from ``AllowedAction``: the task store\nauthorizes *which* credential may be used, while the Broker remains the\nauthority for its current lifecycle state and epoch.",
  "properties": {
    "created_at": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Created At",
      "type": "integer"
    },
    "credential_epoch": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Credential Epoch",
      "type": "integer"
    },
    "credential_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "title": "Credential Id",
      "type": "string"
    },
    "provider": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "title": "Provider",
      "type": "string"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "DISABLED",
        "REVOKED",
        "COMPROMISED",
        "DESTROYED"
      ],
      "title": "Status",
      "type": "string"
    },
    "updated_at": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Updated At",
      "type": "integer"
    }
  },
  "required": [
    "credential_id",
    "provider",
    "status",
    "credential_epoch",
    "created_at",
    "updated_at"
  ],
  "title": "CredentialStatus",
  "type": "object"
}
